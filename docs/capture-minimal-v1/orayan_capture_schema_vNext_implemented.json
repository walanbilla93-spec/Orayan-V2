        "damagedControlWinner",
        "geometry",
        "endpoint",
        "equalRiskUsdt",
        "version"
      ]
    },
    "management_path": {
      "trigger": "Actual stop/target/BE/trailing transition or terminal aggregate; no raw bars/MARK snapshots",
      "fields": [
        "managementPolicy",
        "transition",
        "effectiveAt",
        "oldStop",
        "newStop",
        "oldTarget",
        "newTarget",
        "breakEven",
