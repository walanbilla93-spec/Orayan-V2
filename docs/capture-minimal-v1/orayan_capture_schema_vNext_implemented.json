      "fields": [
        "code",
        "subsystem",
        "severity",
        "bucket",
        "firstAt",
        "lastAt",
        "count",
        "recoveredAt",
        "permanentLoss",
        "downstreamDecisionSkipped",
        "captureWriteFailed"
      ]
    },
    "configuration": {
      "trigger": "First use of an allowlisted nonsecret decision config hash in an epoch",
      "fields": [
        "configHash",
        "config",
        "definitionVersion",
        "activeExperiments",
        "capturePolicyHash"
      ]
    },
    "capture_status": {
      "trigger": "Changed event/counter/retention state; durable all-time ledger independent of retained segment subset",
      "fields": [
        "startedAt",
        "earliestEventId",
        "latestEventId",
        "earliestAt",
        "latestAt",
        "countsByStream",
        "countsByMode",
        "attemptedRows",
        "acceptedRows",
        "lostRows",
        "attemptedBytes",
        "acceptedBytes",
        "lostBytes",
        "closed",
        "cancelled",
        "expired",
        "retainedRows",
        "retainedBytes",
        "prunedRows",
        "prunedFiles",
        "lastPrunedAt",
        "lastError",
        "populationComplete",
        "retentionPolicy",
        "capState",
        "schemaVersion",
        "epochId",
        "healthBuckets",
        "admitted",
        "filled",
        "inheritedLifecycleRows",
        "inheritedClosed",
        "inheritedCancelled",
        "inheritedExpired",
        "populationLedgerVersion",
        "populationCounterMeaning",
        "missingRows",
        "sessionOpen",
        "possibleCrashGap",
        "pendingRows",
        "volatileLostRows",
