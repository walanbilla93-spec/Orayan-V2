        "entryPrice",
        "fillEconomics",
        "fillQuoteSemantic",
        "fillQuoteAgeMs",
        "closedAt",
        "exitPrice",
        "exitTimePrecision",
        "grossPnl",
        "fees",
        "fundingCost",
        "fundingStatus",
        "netPnlBeforeFunding",
        "netPnl",
        "realizedR",
        "realizedRBeforeFunding",
        "holdMs",
        "mfePerUnit",
        "maePerUnit",
        "mfeR",
        "maeR",
        "excursionPrecision",
        "ambiguityCount",
        "managementPolicy",
        "outcomeComplete",
        "censorReason",
        "reasonCode",
        "reasonHash",
        "fillPrice",
        "actualRisk",
        "createdAt",
        "signalAt",
        "sl",
        "tp",
        "qty",
        "realisedRR",
        "closeReason",
        "geometry"
      ]
    },
    "experiment_arm": {
      "trigger": "Only current registered active arm admission, geometry reject, status/fill/management/terminal change; exclude DORMANT",
      "fields": [
