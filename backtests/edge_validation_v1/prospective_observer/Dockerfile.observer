FROM node:22-bookworm-slim AS node
FROM python:3.12-slim-bookworm
COPY --from=node /usr/local/bin/node /usr/local/bin/node
WORKDIR /observer
COPY backtests/edge_validation_v1/prospective_observer/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd --uid 10001 --no-create-home capture && useradd --uid 10002 --no-create-home outcomes && useradd --uid 10003 --no-create-home status
COPY backtests/edge_validation_v1/prospective_observer/ .
RUN python -m unittest test_observer -v && node fixture_parity.js && python keyless_runtime.py --self-test
RUN mkdir /capture
ENV OBSERVER_VOLUME_ROOT=/capture PYTHONUNBUFFERED=1
EXPOSE 8080
CMD ["python", "keyless_runtime.py"]
