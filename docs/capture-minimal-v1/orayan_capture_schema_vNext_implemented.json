        "decisionAt",
        "closedBarOpenAt",
        "admission",
        "rejectReason",
        "score",
        "regime",
        "directionPermission",
        "gateChecks",
        "failedGates",
        "features.score",
        "features.rr",
        "features.slDistPct",
        "features.turnover24h",
        "features.spreadPct",
        "features.volRatio",
        "features.fundingRate_IF_GATE_ACTIVE",
        "features.structureEvent",
        "features.structureTrend",
        "features.entryPath",
        "features.components",
        "geometry.entryPrice",
        "geometry.invalidationPrice",
        "geometry.objectivePrice",
        "geometry.rawRR",
        "geometry.costAdjustedRR",
        "geometry.minCostAdjustedRR",
        "geometry.tickSize",
        "geometry.qtyStep",
        "geometry.minOrderQty",
        "geometry.maxOrderQty",
        "geometry.entryWindowMin",
        "geometry.maxHoldMin",
        "geometry.sizing",
        "geometry.costs",
        "geometry.reactionLevel",
        "geometry.stopLevel",
        "geometry.objectiveLevel",
        "atr.atr1m",
        "atr.definition",
        "atr.cutoff",
        "atr.sourceAt",
        "atr.receivedAt",
        "atr.positiveAtr",
        "atr.usableAtDecision",
        "atr.status",
        "atr.availabilityReason",
        "context.regime",
        "context.strength",
        "quality.quoteStatus",
        "quality.quoteReceivedAt",
        "quality.quoteAgeMs",
        "pairedNativeCandidateIds"
      ]
    },
    "trade_lifecycle": {
      "trigger": "Admitted, intent, ack, fill, cancel/expire, funding-finalization or terminal transition",
      "fields": [
        "transitions",
        "status",
        "outcome",
        "plannedEntry",
        "initialStop",
        "initialTarget",
        "stop",
        "target",
        "quantity",
        "notional",
        "margin",
        "leverage",
        "plannedRiskUsdt",
        "orderIntentAt",
        "orderAckAt",
        "exchangeOrderId",
        "eligibleFromAt",
        "expiresAt",
