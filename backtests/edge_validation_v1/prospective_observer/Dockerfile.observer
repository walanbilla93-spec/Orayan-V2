FROM node:22-bookworm-slim AS node
FROM python:3.12-slim-bookworm
COPY --from=node /usr/local/bin/node /usr/local/bin/node
WORKDIR /observer
COPY backtests/edge_validation_v1/prospective_observer/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd --uid 10001 --create-home observer
COPY backtests/edge_validation_v1/prospective_observer/ .
RUN mkdir /capture && chown observer:observer /capture
USER 10001:10001
ENV OBSERVER_DATA_DIR=/capture
EXPOSE 8080
CMD ["python", "observer.py", "run"]
